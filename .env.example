# Local container port.
APP_PORT=8080

# Copying this file opts into the PostgreSQL 17 profile.
COMPOSE_PROFILES=prod
STORAGE=postgres

# Deterministic demo runtime.
AGENT_MODE=demo
DEMO_STEP_DELAY=220ms
HISTORY_RETENTION=168h

# Optional online model. Keep AGENT_MODE=demo when these are empty.
LLM_API_STYLE=responses
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional browser map. Vite embeds these values at image build time.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JS_CODE=

# Optional PostgreSQL 17 profile. This key is public and only suitable for a local demo.
POSTGRES_PASSWORD=waybill
DATABASE_URL=postgres://waybill:waybill@postgres:5432/waybill?sslmode=disable
CHECKPOINT_KEY_ID=local-v1
CHECKPOINT_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
TENANT_ID=local-demo
